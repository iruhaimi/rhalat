{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hgxvwziiumjxifpgpjce.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "visa-faster",
      "version": "0.1.0",
      "title": "visa-faster"
    },
    "tools": [
      {
        "name": "list_countries",
        "title": "List destination countries",
        "description": "List active visa destination countries offered by the service, with country code and whether it is a Schengen state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Optional case-insensitive filter on the country name."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_visa_types",
        "title": "List visa types and pricing",
        "description": "List active visa types for a destination country, including price, processing days, validity and government fees.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "country_code": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4,
              "description": "ISO country code, e.g. FR, IT, GB."
            }
          },
          "required": [
            "country_code"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_applications",
        "title": "List my visa applications",
        "description": "List the signed-in user's own visa applications with reference number, status, travel date and destination.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Optional status filter, e.g. draft, submitted, approved."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum applications to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_application_status",
        "title": "Get one of my applications",
        "description": "Get full status details for one of the signed-in user's visa applications by its reference number (e.g. VF-2026-0001) or id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 3,
              "description": "Application reference number (display number) or application id."
            }
          },
          "required": [
            "reference"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
