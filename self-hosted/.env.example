# === Domain ===
DOMAIN=visafaster.com
ACME_EMAIL=admin@visafaster.com

# === PostgreSQL ===
POSTGRES_USER=visafaster
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=visafaster
DATABASE_URL=postgresql://visafaster:change_me_strong_password@postgres:5432/visafaster?schema=public

# === Redis ===
REDIS_URL=redis://redis:6379

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=eu-central-1
MINIO_PUBLIC_URL=https://files.visafaster.com

# === Backend ===
NODE_ENV=production
PORT=3000
SESSION_SECRET=change_me_64_char_random_string
COOKIE_DOMAIN=.visafaster.com
FRONTEND_URL=https://visafaster.com

# === Email (SMTP) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@notify.visafaster.com
SMTP_PASS=change_me
SMTP_FROM="عطلات رحلاتكم <noreply@notify.visafaster.com>"

# === OAuth (Google) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://visafaster.com/api/auth/google/callback

# === hCaptcha ===
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# === Backups (S3-compatible offsite) ===
RESTIC_REPOSITORY=s3:s3.amazonaws.com/visafaster-backups
RESTIC_PASSWORD=change_me_restic_password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Monitoring ===
GRAFANA_ADMIN_PASSWORD=change_me_grafana